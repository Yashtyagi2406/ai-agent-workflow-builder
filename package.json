{
  "name": "ai-workflow-builder-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "seed": "npx tsx scripts/seed.ts",
    "dev:functions": "cd nhost/functions && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd nhost/functions && npm install && cd "../../frontend" && npm install"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
